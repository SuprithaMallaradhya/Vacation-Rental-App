# Azure deployment settings. `./deploy/deploy.sh init` copies this to deploy/azure.env
# (ignored by Git) and fills in a unique SUFFIX and generated secrets. Edit before `infra` if needed.

# Region: Azure for Students only allows some regions. `./deploy/deploy.sh check` tests the choice.
LOCATION=northcentralus
# Lowercase letters/digits, makes globally unique names (DB server, storage account, DNS label).
SUFFIX=

RESOURCE_GROUP=vr-rg
VNET=vr-vnet
SUBNET=app
NSG=vr-app-nsg
PUBLIC_IP=vr-ip
LB=vr-lb
VMSS=vr-vmss
AUTOSCALE=vr-autoscale

# B2ats_v2 (2 vCPU AMD, 1 GiB) is in the Azure free-services list (750 h/month for 12 months).
VM_SIZE=Standard_B2ats_v2
MIN_INSTANCES=1
MAX_INSTANCES=3
SCALE_OUT_CPU=60
SCALE_IN_CPU=25

# Azure Database for PostgreSQL Flexible Server, Burstable B1ms (free-services list).
DB_ADMIN=vradmin
DB_PASSWORD=
DB_NAME=vacation_rental

# Shared by every VM; generated by `init`.
JWT_SECRET_KEY=

# Container images built by .github/workflows/images.yml (owner must be lowercase).
API_IMAGE=ghcr.io/suprithamallaradhya/vacation-rental-api:latest
WEB_IMAGE=ghcr.io/suprithamallaradhya/vacation-rental-web:latest
# Leave empty if the GHCR packages are public. Otherwise a GitHub user + PAT with read:packages.
GHCR_USER=
GHCR_TOKEN=
