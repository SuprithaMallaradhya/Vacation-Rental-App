# Copy to deploy/.env.prod for a local production-like run (make prod-local-up).
# On Azure, deploy/deploy.sh generates this file for the VMs from deploy/azure.env.
# Never commit real values.

APP_ENV=production
APP_NAME=Vacation Rental API
LOG_LEVEL=INFO

# Local run: the development database on your laptop.
# Azure: postgresql+asyncpg://<admin>:<password>@<server>.postgres.database.azure.com:5432/vacation_rental?ssl=require
DATABASE_URL=postgresql+asyncpg://vacation:vacation@host.docker.internal:55432/vacation_rental_dev

# Same origin as the UI. Local: http://localhost:8080  Azure: http://<dns-label>.<region>.cloudapp.azure.com
CORS_ORIGINS=http://localhost:8080
API_PUBLIC_BASE_URL=http://localhost:8080

# Generate with: python3.12 -c 'import secrets; print(secrets.token_urlsafe(48))'
# Every VM must use the SAME value, or tokens issued by one VM fail on another.
JWT_SECRET_KEY=

JWT_EXPIRE_MINUTES=60
LOGIN_MAX_ATTEMPTS=10
LOGIN_WINDOW_SECONDS=60

# Media uploads. "local" stores files on one machine's disk and is fine for a local run only.
# Behind the load balancer use "azure" (deploy.sh sets these for you).
STORAGE_PROVIDER=local
# STORAGE_PROVIDER=azure
# AZURE_STORAGE_ACCOUNT_NAME=
# AZURE_STORAGE_ACCOUNT_KEY=
# AZURE_STORAGE_CONTAINER=listing-media
